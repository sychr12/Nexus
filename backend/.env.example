# Copy this file to `.env` for local development. Do not commit `.env`.
# Production secrets must come from the deployment secret manager or environment.

SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5432/sicpr
DB_USERNAME=postgres
DB_PASSWORD=change-me-local-db-password

# Security
# Keep DATA_ENCRYPTION_KEY stable after data is created. Changing it makes
# existing encrypted records unreadable unless a planned key rotation is built.
# In production, DATA_SEARCH_HASH_KEY must be different from DATA_ENCRYPTION_KEY.
JWT_SECRET=change-me-local-jwt-secret-with-at-least-32-characters
JWT_EXPIRATION_MS=86400000
DATA_ENCRYPTION_KEY=change-me-local-data-encryption-key-32-plus-chars
DATA_SEARCH_HASH_KEY=change-me-local-search-hash-key-32-plus-chars

# Browser/API integration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:*
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Local-only helpers
FLUXO_DEV_SEED_ENABLED=true
SENSITIVE_DATA_MIGRATION_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe@123
BOOTSTRAP_ADMIN_NAME=Administrador SICPR
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
BOOTSTRAP_USERS_ENABLED=false
# Format: username|password|nomeCompleto|perfil|unidadeLocal;username2|password2|nomeCompleto2|perfil2|unidadeLocal2
BOOTSTRAP_USERS_ENTRIES=gerente_manacapuru|ChangeMe@123|Gerente Manacapuru|GERENTE|Manacapuru;tecnico_manacapuru|ChangeMe@123|Tecnico Manacapuru|TECNICO|Manacapuru
